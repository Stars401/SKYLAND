{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "SKYLAND",
  "version": "0.19.11",
  "identifier": "com.skyland.app",
  "build": {
    "frontendDist": "../skyland-web/static",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "cargo run -p skyland-web",
    "beforeBuildCommand": ""
  },
  "app": {
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "SKYLAND — AI 智能开发工作台",
    "longDescription": "SKYLAND 是一个 Web-native 智能开发工作台，提供 AI 智能体对话和技术知识库两大核心功能。"
  }
}
